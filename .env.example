# Skopiuj do .env i uzupełnij. NIGDY nie commituj .env.
# Klucze wygenerujesz:  docker compose run --rm app python -m app.cli gen-keys
POSTGRES_PASSWORD=zmien_mnie
SECRET_KEY=
ENCRYPTION_KEY=

# closed = tylko konta z CLI (domyślnie, bezpieczne dla publicznego repo)
# invite = rejestracja z kodem zaproszenia | open = każdy może założyć konto
REGISTRATION_MODE=closed
SERVER_NAME=Profile Manager
MAX_USERS=0
MAX_PROFILE_MB=2048
USER_QUOTA_MB=0
MAX_PROFILES_PER_USER=0
KEEP_BACKUPS=1
LEASE_TTL_SECONDS=90

# 127.0.0.1 = tylko lokalnie (użyj reverse proxy/Tailscale), 0.0.0.0 = w całej sieci
PM_BIND=0.0.0.0
PM_PORT=8000
